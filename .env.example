# OpenAIR 本地开发配置模板
#
# 1. 复制为 .env（勿提交）：Copy-Item .env.example .env
# 2. 标了 [KEY] 的填真实密钥；其余默认一般可直接跑
# 3. 启动见 docs/03_工程/待专项更新/LOCAL_DEVELOPMENT.md
#
# 注意：本文件所有注释独立成行——.env 的行内注释在部分 Compose 版本会被并入变量值，
# 空值行（KEY= # 注释）会把整段注释当成密钥，导致启动失败。
# 本文件只给本地用。云端用 .env.zeabur.*，别整份拷上去。
# 本机 API 和 durable-worker 必须共用同一份 .env。

# ===== Claude（跑 Skill / Agent 用）=====
# Claude 请求发到哪；慧言/智谱等网关填这里
ANTHROPIC_BASE_URL=https://api.example-gateway.com
# [KEY] Claude 密钥；空则 Skill 跑不了
ANTHROPIC_API_KEY=
# 少数网关用 token 顶替上面的 KEY
ANTHROPIC_AUTH_TOKEN=
# 旧别名，一般留空；真正用的是下面 OPENAIR_CLAUDE_MODEL
ANTHROPIC_MODEL=
# 网关要求时才填：Haiku 档模型名
ANTHROPIC_DEFAULT_HAIKU_MODEL=
# 网关要求时才填：Sonnet 档模型名
ANTHROPIC_DEFAULT_SONNET_MODEL=
# 网关要求时才填：Opus 档模型名
ANTHROPIC_DEFAULT_OPUS_MODEL=
# Skill/Agent 实际用的模型；改它才会换执行模型
OPENAIR_CLAUDE_MODEL=claude-sonnet-4-5
# 1=关掉 Claude CLI 多余联网；本地建议保持 1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# 可选：Claude 请求超时（毫秒）
# API_TIMEOUT_MS=

# ===== 规划器 / Router（开题、出方案用；走 OpenAI 兼容接口）=====
# 注意：这里不要填 ANTHROPIC 那种 …/api/anthropic 地址，否则规划会 404。
# 规划器请求地址（OpenAI 兼容）
LLM_PROVIDER_BASE_URL=https://api.example-gateway.com
# [KEY] 规划器密钥；空则开题/出方案失败
LLM_PROVIDER_API_KEY=
# 默认规划模型
LLM_PROVIDER_MODEL=gpt-5.6-terra
# Terra 档模型别名
LLM_PROVIDER_MODEL_TERRA=gpt-5.6-terra
# Sol 档模型别名
LLM_PROVIDER_MODEL_SOL=gpt-5.6-sol
# 允许选用的模型白名单；不在名单里会启动校验失败
LLM_PROVIDER_SUPPORTED_MODELS=gpt-5-mini,gpt-5.3-codex,gpt-5.5,gpt-5.2,claude-sonnet-4-6,claude-sonnet-4-5,claude-opus-4-7,claude-haiku-4-5-20251001,claude-sonnet-4-20250514,gpt-4o,gpt-4o-mini,deepseek-v3.2,qwen3.5-plus,glm-5.1,kimi-k2.6,gemini-2.5-pro,gemini-3-pro-preview
# 研究方案规划器用哪款模型
OPENAIR_RESEARCH_START_PLANNER_LLM_MODEL=gpt-5.6-terra
# 规划器最长 token
# OPENAIR_RESEARCH_START_PLANNER_LLM_MAX_TOKENS=1800
# 规划器关掉思考（部分免费模型需要）
# OPENAIR_RESEARCH_START_PLANNER_LLM_THINKING=disabled
# Planner 正式任务预算（秒）；Provider 不得二次截短
# OPENAIR_RESEARCH_START_PLANNER_LLM_TIMEOUT_SECONDS=120
# 确认执行时的编排模型：关思考
# OPENAIR_DURABLE_ORCHESTRATE_LLM_THINKING=disabled
# 编排模型最长 token
# OPENAIR_DURABLE_ORCHESTRATE_LLM_MAX_TOKENS=4000
# 轨迹/兼容层用哪个 provider 名；一般保持默认
OPENTRAJECTORY_LLM_PROVIDER=huiyan_chat_completions

# ===== 前端（pnpm dev 读；改完要重启前端）=====
# 前端展示用的文本模型名（提示用）
VITE_TEXT_LLM_MODEL=gpt-5.4-mini
# 前端请求后端地址；Windows 连不上可改 http://[::1]:8000
VITE_OPENAIR_API_BASE_URL=http://127.0.0.1:8000
# 旧静态令牌；现在优先 JWT 登录，一般不用
# VITE_OPENAIR_AUTH_TOKEN=

# ===== 外部检索（文献类 Skill；可选）=====
# [KEY] DeepXiv；空则该检索源不可用
OT_DEEPXIV_TOKEN=
# 同上，另一种变量名
# DEEPXIV_TOKEN=
# 同上，另一种变量名
# DEEPXIV_API_KEY=
# [KEY] Semantic Scholar；空则该源不可用
SEMANTIC_SCHOLAR_API_KEY=
# Unpaywall 联系邮箱；他们要求填一个邮箱
UNPAYWALL_EMAIL=dev@example.com
# CORE 文献库密钥；可选
CORE_API_KEY=
# OpenAlex 密钥；可选
OPENALEX_API_KEY=

# ===== 材料相关 Skill（可选）=====
# 材料 MCP 服务地址；空则材料 MCP Skill 连不上
MATERIALS_MCP_BASE_URL=
# [KEY] Materials Project 密钥
MP_API_KEY=
# 交叉/配方类 Skill 用的小模型
CROSSOVER_LLM_MODEL=gpt-4o-mini
# 交叉实验计划专用模型；不填则跟上面走
# CROSSOVER_RUNPLAN_LLM_MODEL=
# 本地赝势目录（材料算力扩展）
# VASP_PSP_DIR=
# 超算/集群 API 地址
# JCC_BASE_URL=
# 集群账号
# JCC_USERNAME=
# 集群密码
# JCC_PASSWORD=
# 集群名字
# JCC_CLUSTER_NAME=
# jcc.exe 路径；默认仓库内 skills/materials/jcc/jcc.exe
# JCC_CLI_PATH=
# 算力清单缓存过期阈值（过期后访问触发后台补采）
# JCC_INVENTORY_TTL_SECONDS=86400

# ===== 资源广场平台清单（可选）=====
# 云实验平台地址；默认 http://<flux-base-url>（内网）
# FLUX_BASE_URL=
# [KEY] 云实验平台 X-Api-Key；本地开发也可放
#   skills/materials/flux-experiment/config.local.json（env 优先）
# FLUX_API_KEY=
# flux open api 单请求超时（秒）
# FLUX_TIMEOUT=10

# ===== 运行时核心 =====
# live=真调模型；replay=回放录像（演示/排障，无需任何模型密钥）
SKILL_EXEC_MODE=live
# inline=本机直接跑；container=丢进 Docker worker
OPENAIR_RUNTIME_TYPE=inline
# true=走新研究编排；关了主流程会异常
OPENAIR_RESEARCH_ORCHESTRATION_V1=true
# 1=启动灌演示数据（仅 json 存储后端生效；compose 默认 postgres 下无效）
OPENAIR_DEV_SEED_FIXTURES=0
# 本地静态口令（旧路径）；可改，别跟别人冲突即可
OPENAIR_AUTH_TOKEN=openair-local-dev-token
# API 与 worker 互认口令；两边必须相同，否则领不到任务
OPENAIR_WORKER_AUTH_TOKEN=openair-local-worker-token
# 登录 JWT 签名密钥；本地可随便，生产必须随机长串
OPENAIR_JWT_SECRET_KEY=replace-with-a-random-local-secret
# 启动时自动创建/提权的管理员邮箱
# OPENAIR_BOOTSTRAP_ADMIN_EMAIL=ops@example.com
# 管理员密码（至少 8 位）
# OPENAIR_BOOTSTRAP_ADMIN_PASSWORD=
# 管理员用户名
# OPENAIR_BOOTSTRAP_ADMIN_USERNAME=ops
# 1=每次启动用上面密码覆盖库里的密码
# OPENAIR_BOOTSTRAP_ADMIN_SYNC_PASSWORD=0
# 1=注册要图形验证码；本地默认关
# OPENAIR_CAPTCHA_ENABLED=1
# 允许哪些前端地址跨域调 API；缺了浏览器会报 CORS
OPENAIR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# worker 只领这个时间之后的任务；本地填过去时间即可
OPENAIR_DURABLE_CLAIM_NOT_BEFORE=2020-01-01T00:00:00Z

# ===== MinIO（文件/产物存储；compose 起 minio 时需要）=====
# MinIO 管理员用户名
OPENAIR_MINIO_ROOT_USER=openair
# MinIO 管理员密码；改了下面 ACCESS/SECRET 也要一起改
OPENAIR_MINIO_ROOT_PASSWORD=openair-local-dev-password
# MinIO S3 端口（浏览器/SDK 用）
OPENAIR_MINIO_API_PORT=9000
# MinIO 网页控制台端口
OPENAIR_MINIO_CONSOLE_PORT=9001
# 本机连 MinIO 的地址（不要加 http://）
OPENAIR_MINIO_ENDPOINT=localhost:9000
# 同一 MinIO 的 Docker 持久化地址在宿主机不可达时，显式映射传输地址；不改变桶或 TLS。
# OPENAIR_MINIO_SCOPE_ENDPOINT_OVERRIDES={"minio+http://minio:9000/openair-artifacts":"localhost:9000"}
# 应用侧访问密钥；启用 MinIO 产物时取消注释
# OPENAIR_MINIO_ACCESS_KEY=openair
# 应用侧密钥；须与 ROOT_PASSWORD 一致
# OPENAIR_MINIO_SECRET_KEY=openair-local-dev-password
# 产物桶名；不填则用代码默认
# OPENAIR_MINIO_BUCKET=openair-artifacts
# 1=https；本地一般 0
# OPENAIR_MINIO_SECURE=0
# 设为 minio 后产物进对象存储；默认 local 用本地盘
# OPENAIR_ARTIFACT_STORAGE=minio

# ===== 用户上传自定义 Skill 的上限（可选）=====
# 一次最多传多少个文件
# OPENAIR_USER_SKILL_MAX_FILES=200
# 单文件最大字节（默认 1MB）
# OPENAIR_USER_SKILL_MAX_FILE_BYTES=1048576
# 整个 Skill 总大小上限（默认 10MB）
# OPENAIR_USER_SKILL_MAX_TOTAL_BYTES=10485760
# 一次能注入 worker 的 Skill 个数
# OPENAIR_USER_SKILL_MANIFEST_MAX_SKILLS=20
# manifest 里最多记多少文件
# OPENAIR_USER_SKILL_MANIFEST_MAX_FILES=500
# manifest JSON 最大体积
# OPENAIR_USER_SKILL_MANIFEST_MAX_BYTES=32768

# ===== GitHub 登录（可选；产品侧暂时关掉）=====
# 恢复时：改 routes/oauth.py 里 GITHUB_OAUTH_TEMPORARILY_UNAVAILABLE=False，并设下面 ENABLED=true
# GitHub OAuth App 的 Client ID
OPENAIR_GITHUB_OAUTH_CLIENT_ID=
# Client Secret
OPENAIR_GITHUB_OAUTH_CLIENT_SECRET=
# 回调地址，须与 GitHub 后台一致
OPENAIR_GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/github/callback
# 登录成功后跳回前端哪一页
OPENAIR_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:8080/auth/oauth/callback
# false=不启用 GitHub 登录按钮
OPENAIR_GITHUB_OAUTH_ENABLED=false
# GitHub 授权范围
# OPENAIR_GITHUB_OAUTH_SCOPES=read:user user:email

# ===== OpenI 登录（可选；别复用 GitHub 的 Client）=====
# OpenI 应用 ID
OPENAIR_OPENI_OAUTH_CLIENT_ID=
# OpenI 应用密钥
OPENAIR_OPENI_OAUTH_CLIENT_SECRET=
# OpenI 回调地址
OPENAIR_OPENI_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/openi/callback
# OpenI 站点地址；一般不用改
# OPENAIR_OPENI_OAUTH_BASE_URL=https://openi.pcl.ac.cn
# 授权范围；多数情况留空
# OPENAIR_OPENI_OAUTH_SCOPES=

# ===== GitLink 登录（可选）=====
# GitLink 应用 ID
OPENAIR_GITLINK_OAUTH_CLIENT_ID=
# GitLink 应用密钥
OPENAIR_GITLINK_OAUTH_CLIENT_SECRET=
# GitLink 回调地址
OPENAIR_GITLINK_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/gitlink/callback
# 授权页
# OPENAIR_GITLINK_OAUTH_AUTHORIZE_URL=https://www.gitlink.org.cn/oauth/authorize
# 换 token
# OPENAIR_GITLINK_OAUTH_TOKEN_URL=https://www.gitlink.org.cn/oauth/token
# 用户信息
# OPENAIR_GITLINK_OAUTH_USERINFO_URL=https://www.gitlink.org.cn/api/users/me.json
# 授权范围；一般留空
# OPENAIR_GITLINK_OAUTH_SCOPES=

# ===== PostgreSQL（任务/编排数据；API 与 worker 必须完全一致）=====
# postgres=用数据库；改 json 会走旧文件存储（本地不推荐）
OPENAIR_PERSISTENCE_BACKEND=postgres
# 数据库主机；本机 compose 用 localhost
POSTGRES_HOST=localhost
# 数据库映射端口；和下面 OPENAIR_POSTGRES_PORT 保持相同
POSTGRES_PORT=15432
# compose 映射到宿主机的端口；冲突时两处一起改
OPENAIR_POSTGRES_PORT=15432
# 数据库用户名
POSTGRES_USER=openair
# 数据库密码；API/worker 必须相同
POSTGRES_PASSWORD=openair-local-dev-password
# 库名
POSTGRES_DATABASE=openair
# 1=启动自动跑迁移建表；本地建议开着
OPENAIR_POSTGRES_MIGRATIONS_AUTO_APPLY=1

# ===== 用户额度（不填就用代码默认）=====
# trial 用户一次性额度
# OPENAIR_QUOTA_TRIAL_LIMIT=2000000
# free 用户每日额度
# OPENAIR_QUOTA_FREE_LIMIT=200000
# pro 用户每月额度
# OPENAIR_QUOTA_PRO_LIMIT=50000000
# internal 用户每月额度
# OPENAIR_QUOTA_INTERNAL_LIMIT=50000000

# ===== 高级（一般不用动）=====
# 1=强制登录；本地默认可不开
# OPENAIR_AUTH_REQUIRED=1
# 快速执行时的默认 Skill
# OPENAIR_DEFAULT_SKILL_ID=literature_review
# Claude 权限模式；无头跑常用 bypassPermissions
# OPENAIR_CLAUDE_PERMISSION_MODE=bypassPermissions
# 研究派发最多重试几次；API/worker 须相同
# OPENAIR_RESEARCH_DISPATCH_MAX_ATTEMPTS=5
# continuation 未分类内部错误有限恢复次数；须相同
# OPENAIR_RESEARCH_DISPATCH_CONTINUATION_INTERNAL_ERROR_MAX_ATTEMPTS=3
# 重新解析最多几次；须相同
# OPENAIR_RESEARCH_DISPATCH_RERESOLVE_MAX_ATTEMPTS=2
# 重试基础间隔（秒）
# OPENAIR_RESEARCH_DISPATCH_RETRY_BASE_SECONDS=15
# 重试最大间隔（秒）
# OPENAIR_RESEARCH_DISPATCH_RETRY_MAX_SECONDS=300
# 单 Worker 并发执行槽（2-64）
# OPENAIR_DURABLE_WORKER_EXECUTION_CAPACITY=8
# 1=任务目录隔离更严（需额外条件）
# OPENAIR_WORKER_WORKSPACE_ISOLATION=0
# 1=每个任务单独回调令牌
# OPENAIR_WORKER_PER_TASK_TOKEN=0
# 1=worker 跑完不销毁，复用容器（实验特性）
# OPENAIR_WORKER_KEEPALIVE=0
# container 模式下用的 worker 镜像名
# OPENAIR_WORKER_IMAGE=openair-worker:latest
# compose 前端对外端口
# OPENAIR_WEB_PORT=8080
# development/production；影响校验松紧与种子数据
# OPENAIR_ENV=development
# 日志详细程度：DEBUG/INFO/WARNING/ERROR
# OPENAIR_LOG_LEVEL=INFO
# text=人读；json=给采集系统用
# OPENAIR_LOG_FORMAT=text
# mmp 平台 MCP 地址；不用就留空
# OPENAIR_MMP_MCP_URL=
