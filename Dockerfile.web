# OpenAIR Web — Zeabur / cloud Docker entrypoint (repo root).
# Zeabur service name should be "web", or set ZBPACK_DOCKERFILE_NAME=web /
# ZBPACK_DOCKERFILE_PATH=Dockerfile.web.
#
# This file is the production Zeabur SPA image (cross-origin API via
# VITE_OPENAIR_API_BASE_URL). Do not confuse with apps/web/Dockerfile
# (compose image: same-origin nginx reverse-proxy to api:8000).
#
# Build (from repo root):
#   docker build -f Dockerfile.web \
#     --build-arg VITE_OPENAIR_API_BASE_URL=https://api.example.com \
#     -t openair-web:zeabur .

FROM node:20-alpine AS builder

ENV CI=1 \
    NODE_OPTIONS=--max-old-space-size=4096

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile

COPY packages/shared/ ./packages/shared/
COPY apps/web/ ./apps/web/
COPY fixtures/ ./fixtures/

# Zeabur injects build-time env vars as Docker ARG automatically.
ARG VITE_OPENAIR_API_BASE_URL
ENV VITE_OPENAIR_API_BASE_URL=${VITE_OPENAIR_API_BASE_URL}

RUN pnpm --filter @openair/web build

FROM nginx:alpine

COPY deploy/nginx/web.conf /etc/nginx/conf.d/configfile.template
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

ENV HOST=0.0.0.0

EXPOSE 8080

CMD sh -c "envsubst '\$PORT' < /etc/nginx/conf.d/configfile.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"
