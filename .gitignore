# Secrets — auto-generated locally, never commit
services/api/.dev_jwt_secret

# agent — .claude 入仓白名单：仅共享 settings 与 agents 定义（SPEC-SEC-02 白名单模式）；
# 其余（skills 镜像、settings.local.json、本地状态）保持忽略
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
.trae/
.cursor/
.qoder/
.agents/

# archive / local reports
_archive/

# generated local evidence / smoke artifacts (root only — anchor to avoid
# catching tracked source like apps/web/src/components/artifacts/)
/artifacts/

# persisted task workspace (root only)
/workspace/

# local dev tools / debug scripts
scripts/local/
tools/local/

# persisted task data (root only — without the leading slash this also
# matched apps/web/src/data/, which forced `git add -f` on tracked source)
/data/

# playwright (local runner outputs; harness also ignores under evals/)
.playwright-mcp
/test-results/
/playwright-report/

# opentrajectory generated runtime outputs
skills/opentrajectory/tests/execution_outputs/

# local smoke payloads (keep examples/; do not version generated smoke dumps)
skills/opentrajectory/**/tests/smoke/*_output.json
skills/opentrajectory/**/tests/smoke/*_results.json
skills/opentrajectory/**/tests/smoke/*_results*.json
skills/opentrajectory/**/tests/smoke/smoke_results.json
skills/opentrajectory/**/tests/smoke/full_source_results.json
skills/opentrajectory/**/tests/smoke/formal_adapter_smoke_results.json

# docker dev
docker-compose.override.y*ml

# XRD skill — keep local, exclude from git for now (large data + WIP)
skills/materials/materials-auto-xrd/

# CVD/FLUX capability-call mocks — keep local, untracked (reference
# .claude/skills/execute-cvd-reactor which is not in repo yet)
fixtures/capability_calls/mocks/

# materials design scratch workspaces — local iteration artifacts, not shared
skills/materials/evaluation/
skills/materials/crystal-design-formula-crossover-workspace/

# verification/ — 测试代码架构：仅长期 Suite 入库；运行过程/WIP/隔离 runtime 留本地。
# 注意：写成 `verification/` 会挡住子路径反向规则，必须用 /* + !suites/
/verification/*
!/verification/suites/
!/verification/suites/**

# 阶段性诊断探针默认不入库（形成正式 Suite / Eval 后再显式纳入）
/tools/diagnostics/**

# 常见本地证据压缩包（防误 add；verification 过程目录已由上方规则覆盖）
*.run.zip
*.evidence.zip

# pycache re-ignore after the suites whitelist above (last-match wins);
# bare local __pycache__ dirs made the guard see suiteless formal suites
verification/suites/**/__pycache__/

# Local Codex/Cursor temporary worktrees and acceptance artifacts
.codex-tmp-*/
apps/web/artifacts/

# Local investigation, source snapshots and independent review notes.
# Keep task specifications and formal product/engineering contracts versioned.
/docs/dev_plans/research-package/
/docs/03_工程/可复现研究包/2026-10-09_接续盘点.md
/docs/dev_plans/three-line-20261009/OT-rework-independent-review.md
/docs/task_specs/2026-10-09-OT-review-rework.md


