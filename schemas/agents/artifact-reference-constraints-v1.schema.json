{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openair.local/schemas/agents/artifact-reference-constraints-v1.schema.json",
  "title": "OpenAIR artifact reference constraints v1",
  "description": "Versioned declaration format for local artifact identifier and reference constraints. A conforming constraint evaluator performs the semantic checks defined by the companion v1 specification and fails closed for any declaration it cannot interpret.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "identifierCollections", "rules"],
  "properties": {
    "version": { "const": "1.0.0" },
    "identifierCollections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identifierCollection" }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "pointer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "pattern": "^/(?:\\*|(?:[^~/*]|~[01])+)(?:/(?:\\*|(?:[^~/*]|~[01])+))*$"
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "duplicate_identifier",
        "reference_target_missing",
        "reference_relation_inconsistent",
        "reference_constraint_invalid_pointer",
        "reference_constraint_unknown_rule_kind",
        "reference_constraint_ambiguous_wildcard"
      ]
    },
    "identifierCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identifierPointers", "duplicateErrorCode"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "identifierPointers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pointer" }
        },
        "duplicateErrorCode": { "const": "duplicate_identifier" }
      }
    },
    "ruleBase": {
      "type": "object",
      "required": ["id", "kind", "errorCode"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string" },
        "errorCode": { "$ref": "#/$defs/errorCode" }
      }
    },
    "existsRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "errorCode", "sourceReferencePointer", "targetCollectionId"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "kind": { "const": "exists" },
            "errorCode": { "const": "reference_target_missing" },
            "sourceReferencePointer": { "$ref": "#/$defs/pointer" },
            "targetCollectionId": { "$ref": "#/$defs/identifier" }
          }
        }
      ]
    },
    "reciprocalRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "errorCode", "sourceCollectionId", "sourceReferencePointer", "targetCollectionId", "targetReferencePointer"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "kind": { "const": "reciprocal" },
            "errorCode": { "const": "reference_relation_inconsistent" },
            "sourceCollectionId": { "$ref": "#/$defs/identifier" },
            "sourceReferencePointer": { "$ref": "#/$defs/pointer" },
            "targetCollectionId": { "$ref": "#/$defs/identifier" },
            "targetReferencePointer": { "$ref": "#/$defs/pointer" }
          }
        }
      ]
    },
    "consistentRule": {
      "allOf": [
        { "$ref": "#/$defs/ruleBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "errorCode", "leftCollectionId", "rightCollectionId", "comparison"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "kind": { "const": "consistent" },
            "errorCode": { "const": "reference_relation_inconsistent" },
            "leftCollectionId": { "$ref": "#/$defs/identifier" },
            "rightCollectionId": { "$ref": "#/$defs/identifier" },
            "comparison": { "const": "set_equal" }
          }
        }
      ]
    },
    "rule": {
      "oneOf": [
        { "$ref": "#/$defs/existsRule" },
        { "$ref": "#/$defs/reciprocalRule" },
        { "$ref": "#/$defs/consistentRule" }
      ]
    }
  }
}
