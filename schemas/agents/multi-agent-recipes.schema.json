{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openair.local/schemas/agents/multi-agent-recipes.schema.json",
  "type": "object",
  "required": ["schemaVersion", "recipes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
    "template": {
      "type": "object",
      "required": ["templateKey", "role", "requiredSupportedRole", "objectiveTemplate", "dependencyTemplateKeys"],
      "additionalProperties": false,
      "properties": {
        "templateKey": { "$ref": "#/$defs/nonEmpty" },
        "role": { "enum": ["primary", "reviewer", "support"] },
        "requiredSupportedRole": { "enum": ["primary", "reviewer", "support"] },
        "objectiveTemplate": { "$ref": "#/$defs/nonEmpty" },
        "dependencyTemplateKeys": { "$ref": "#/$defs/stringList" }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["recipeId", "recipeVersion", "substageDefinitionId", "substageDefinitionVersion", "applicabilityRuleRefs", "assignmentTemplates", "completionPolicyTemplate", "resultAssemblyPolicyTemplate", "enabled"],
      "additionalProperties": false,
      "properties": {
        "recipeId": { "$ref": "#/$defs/nonEmpty" },
        "recipeVersion": { "type": "integer", "minimum": 1 },
        "substageDefinitionId": { "$ref": "#/$defs/nonEmpty" },
        "substageDefinitionVersion": { "type": "integer", "minimum": 1 },
        "applicabilityRuleRefs": { "$ref": "#/$defs/stringList" },
        "assignmentTemplates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/template" } },
        "completionPolicyTemplate": {
          "type": "object",
          "required": ["requiredTemplateKeys", "successMode", "reviewerTemplateKeys", "reviewRequirement", "partialSuccessAllowed", "onReviewerReject"]
        },
        "resultAssemblyPolicyTemplate": {
          "type": "object",
          "required": ["mode", "assemblerTemplateKey", "finalArtifactRequirements"]
        },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
