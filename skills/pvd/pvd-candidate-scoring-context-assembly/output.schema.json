{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PVD candidate scoring context assembly output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_context"
  ],
  "properties": {
    "research_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_question"
      ],
      "properties": {
        "research_question": {
          "type": "string",
          "minLength": 1
        },
        "research_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "results_or_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mechanisms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparison_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "critical_evidence_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "off_domain_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
