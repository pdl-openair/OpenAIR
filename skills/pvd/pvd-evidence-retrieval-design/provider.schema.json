{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_variants", "design_rationale"],
  "properties": {
    "query_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["search_intent", "query", "covered_parameter_keys", "rationale", "priority"],
        "properties": {
          "search_intent": {"enum": ["core_topic", "constraint_focused", "mechanism_focused", "method_or_strategy", "metric_or_performance", "adjacent_but_relevant", "noise_exclusion"]},
          "query": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u3400-\\u4DBF\\u4E00-\\u9FFF\\uF900-\\uFAFF]*$"},
          "covered_parameter_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 600},
          "priority": {"type": "integer", "minimum": 1, "maximum": 3}
        }
      }
    },
    "design_rationale": {"type": "string", "minLength": 1, "maxLength": 1200}
  }
}
