{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openair.local/pvd-evidence-retrieval-design/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "structured_context",
    "recommendation_parameter_set",
    "parameter_admission_judgments"
  ],
  "properties": {
    "structured_context": {
      "type": "object"
    },
    "recommendation_parameter_set": {
      "type": "object",
      "required": [
        "parameters"
      ],
      "properties": {
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "parameter_key"
            ],
            "properties": {
              "parameter_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "parameter_admission_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "user_intent",
          "parameter_key"
        ],
        "properties": {
          "status": {
            "const": "pending_evidence"
          },
          "user_intent": {
            "const": "evaluate_for_admission"
          },
          "parameter_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "prior_retrieval_design": {
      "$ref": "#/$defs/retrievalDesign"
    },
    "evidence_shortage_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shortageFact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "evidence_shortage_facts"
        ],
        "properties": {
          "evidence_shortage_facts": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "prior_retrieval_design"
        ]
      }
    },
    {
      "if": {
        "required": [
          "prior_retrieval_design"
        ]
      },
      "then": {
        "required": [
          "evidence_shortage_facts"
        ],
        "properties": {
          "evidence_shortage_facts": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "queryVariant": {
      "type": "object",
      "required": [
        "query_id",
        "search_intent",
        "query",
        "covered_parameter_keys",
        "rationale",
        "priority"
      ],
      "properties": {
        "query_id": {
          "type": "string"
        },
        "search_intent": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "covered_parameter_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        }
      }
    },
    "retrievalDesign": {
      "type": "object",
      "required": [
        "contract",
        "mode",
        "query_variants",
        "design_rationale"
      ],
      "properties": {
        "contract": {
          "const": "pvd-evidence-retrieval-design/v1"
        },
        "mode": {
          "enum": [
            "core",
            "core_plus_supplemental"
          ]
        },
        "query_variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/queryVariant"
          }
        },
        "design_rationale": {
          "type": "string"
        },
        "supplemental_trace": {
          "type": "object"
        }
      }
    },
    "shortageFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortage_id",
        "source_artifact_type",
        "source_artifact_ref",
        "reason_code",
        "description",
        "affected_parameter_keys",
        "affected_target_ids"
      ],
      "properties": {
        "shortage_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "source_artifact_type": {
          "enum": [
            "literature_selection",
            "coverage_report",
            "evidence_acquisition"
          ]
        },
        "source_artifact_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reason_code": {
          "enum": [
            "insufficient_candidates",
            "missing_condition",
            "missing_metric",
            "missing_mechanism",
            "missing_baseline",
            "conflict",
            "not_comparable",
            "coverage_gap",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "affected_parameter_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "affected_target_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
