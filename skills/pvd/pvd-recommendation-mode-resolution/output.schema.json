{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PVD recommendation mode resolution output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "initial",
        "next_round"
      ],
      "description": "Initial when no prior canonical system recommendation exists; next_round otherwise."
    }
  }
}
