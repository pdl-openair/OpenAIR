{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PVD Evidence Node Extraction Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "paper_packets",
    "evidence_schema"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "evidence_schema": {
      "type": "object"
    },
    "item_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    }
  }
}
