{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planning_status",
    "selected_records",
    "global_review_focus",
    "uncertainty"
  ],
  "properties": {
    "planning_status": {
      "enum": [
        "planned",
        "insufficient"
      ]
    },
    "selected_records": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "support_target_ids",
          "review_focus",
          "relation_questions"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "support_target_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_focus": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relation_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "factor",
                "response",
                "question"
              ],
              "properties": {
                "factor": {
                  "type": "string",
                  "minLength": 1
                },
                "response": {
                  "type": "string",
                  "minLength": 1
                },
                "question": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "global_review_focus": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
