{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_status",
    "factor_assessments",
    "recommended_next_experiment_focus",
    "limitations"
  ],
  "properties": {
    "analysis_status": {"enum": ["complete", "degraded"]},
    "factor_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factor",
          "candidate_direction",
          "priority_role",
          "evidence_refs",
          "diagnosis_refs",
          "rationale",
          "uncertainty"
        ],
        "properties": {
          "factor": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "candidate_direction": {"enum": ["increase", "decrease", "hold", "change", "uncertain"]},
          "priority_role": {"enum": ["primary_lever", "secondary_lever", "hold_constant", "uncertain"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "diagnosis_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "rationale": {"type": "string", "minLength": 1},
          "uncertainty": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "recommended_next_experiment_focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_refs", "rationale"],
      "properties": {
        "factor_refs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "uniqueItems": true
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
