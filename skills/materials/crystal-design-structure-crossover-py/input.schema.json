{
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "User natural-language goal."
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "material_id",
          "formula_pretty",
          "cif_text"
        ],
        "properties": {
          "material_id": {
            "type": "string",
            "minLength": 1
          },
          "formula_pretty": {
            "type": "string",
            "minLength": 1
          },
          "cif_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\uFEFF]*(?:#[^\\r\\n]*(?:\\r?\\n|\\r)[\\s\\uFEFF]*)*data_[^\\s\\r\\n]+",
            "description": "CIF content beginning with a CIF data block; host file paths are not accepted."
          }
        }
      }
    },
    "task_instruction": {
      "description": "Optional crossover overrides. Candidate/CIF interpretation is owned by this Materials Skill.",
      "type": "object",
      "not": {
        "anyOf": [
          {
            "required": [
              "seed_cifs"
            ]
          },
          {
            "required": [
              "seed_cif_paths"
            ]
          },
          {
            "required": [
              "seed_cif_files"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "goal",
    "candidates"
  ],
  "additionalProperties": false
}
