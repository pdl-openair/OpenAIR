# vasp-thermodynamic-stability skill 本地配置
# 复制为 .env 并填入真实值；脚本优先读本文件，项目根 .env 作后备
# 本文件不入库（.gitignore 已忽略 .env）

# ── jcc HPC 凭证 ──
JCC_BASE_URL=https://your-jcc-server
JCC_USERNAME=your_username
JCC_PASSWORD=your_password
JCC_CLUSTER_NAME=your_cluster
JCC_APP_TYPE=your_app_type

# ── Materials Project ──
MP_API_KEY=your_mp_api_key_here

# ── Python 解释器（需含 pymatgen、mp-api）──
MATERIALS_PY=/path/to/python
EVOLVE_PY=/path/to/python
