{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "source_package",
    "reference_metrics"
  ],
  "anyOf": [
    {
      "required": [
        "research_goal"
      ]
    },
    {
      "required": [
        "reproduction_baseline_and_criteria"
      ]
    }
  ],
  "properties": {
    "research_goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "reproduction_baseline_and_criteria": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "source_package": {
      "type": "object",
      "required": [
        "schema_version",
        "state",
        "source_kind",
        "repository",
        "resolved_commit_sha",
        "workspace_relative_path",
        "documents"
      ],
      "properties": {
        "schema_version": {
          "const": "openair-reference-source-package/v1"
        },
        "state": {
          "const": "succeeded"
        },
        "source_kind": {
          "const": "official_repository"
        },
        "repository": {
          "type": "string"
        },
        "resolved_commit_sha": {
          "type": "string"
        },
        "workspace_relative_path": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12
        }
      },
      "additionalProperties": true
    },
    "reference_metrics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "reference_id",
          "metric_name",
          "value_type",
          "unit"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^refmetric:[0-9a-f]{64}$"
          },
          "metric_name": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "enum": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "repair_feedback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "description": "Non-authoritative correction feedback; source, fixed identities and original research constraints remain authoritative."
    }
  },
  "additionalProperties": false
}
