{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "resources",
    "environment",
    "execution",
    "metric_extraction_jobs",
    "unresolved"
  ],
  "properties": {
    "resources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "usage",
          "execution_usage",
          "resource_kind",
          "repo_id",
          "repo_type",
          "revision",
          "filename",
          "expected_commit_sha",
          "expected_sha256",
          "delivery",
          "source_document_id",
          "source_excerpt"
        ],
        "properties": {
          "usage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "resource_kind": {
            "type": "string",
            "enum": [
              "huggingface_snapshot",
              "huggingface_file"
            ]
          },
          "repo_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "repo_type": {
            "type": "string",
            "enum": [
              "model",
              "dataset"
            ]
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512
          },
          "filename": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024
          },
          "expected_commit_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9A-Fa-f]{40}$"
          },
          "expected_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "delivery": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "argument_index"
                ],
                "properties": {
                  "kind": {
                    "const": "command_argument"
                  },
                  "argument_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 254
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "tar_extract_working_directory"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "source_document_id": {
            "type": "string",
            "pattern": "^refdoc:[0-9a-f]{64}$"
          },
          "source_excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "execution_usage": {
            "type": "string",
            "enum": [
              "model",
              "dataset"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "python_version",
        "requirements",
        "verify_imports",
        "find_links"
      ],
      "properties": {
        "python_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "value",
                "source_document_id",
                "source_excerpt"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source_document_id": {
                  "type": "string",
                  "pattern": "^refdoc:[0-9a-f]{64}$"
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "requirements": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "source_document_id",
                  "source_excerpt"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source_document_id": {
                    "type": "string",
                    "pattern": "^refdoc:[0-9a-f]{64}$"
                  },
                  "source_excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "verify_imports": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "source_document_id",
                  "source_excerpt"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source_document_id": {
                    "type": "string",
                    "pattern": "^refdoc:[0-9a-f]{64}$"
                  },
                  "source_excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        },
        "find_links": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "source_document_id",
                  "source_excerpt"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "source_document_id": {
                    "type": "string",
                    "pattern": "^refdoc:[0-9a-f]{64}$"
                  },
                  "source_excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "entrypoint",
        "arguments",
        "working_directory",
        "timeout_seconds",
        "environment_variables"
      ],
      "properties": {
        "entrypoint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "value",
                "source_document_id",
                "source_excerpt"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source_document_id": {
                  "type": "string",
                  "pattern": "^refdoc:[0-9a-f]{64}$"
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "arguments": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "value",
                "source_document_id",
                "source_excerpt"
              ],
              "properties": {
                "value": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "source_document_id": {
                  "type": "string",
                  "pattern": "^refdoc:[0-9a-f]{64}$"
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "working_directory": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "value",
                "source_document_id",
                "source_excerpt"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "source_document_id": {
                  "type": "string",
                  "pattern": "^refdoc:[0-9a-f]{64}$"
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "timeout_seconds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "value",
                "source_document_id",
                "source_excerpt"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 86400
                },
                "source_document_id": {
                  "type": "string",
                  "pattern": "^refdoc:[0-9a-f]{64}$"
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "environment_variables": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "value",
                "source_document_id",
                "source_excerpt"
              ],
              "properties": {
                "value": {
                  "type": "object",
                  "maxProperties": 64,
                  "propertyNames": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "source_document_id": {
                  "type": "string",
                  "pattern": "^refdoc:[0-9a-f]{64}$"
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "metric_extraction_jobs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "reference_ids",
          "result_source",
          "selectors"
        ],
        "properties": {
          "reference_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^refmetric:[0-9a-f]{64}$"
            }
          },
          "result_source": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "stream",
                  "format",
                  "table",
                  "source_document_id",
                  "source_excerpt"
                ],
                "properties": {
                  "kind": {
                    "const": "execution_stream"
                  },
                  "stream": {
                    "type": "string",
                    "enum": [
                      "stdout",
                      "stderr"
                    ]
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "tsv",
                      "pipe_table"
                    ]
                  },
                  "table": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "source_document_id": {
                    "type": "string",
                    "pattern": "^refdoc:[0-9a-f]{64}$"
                  },
                  "source_excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "relative_path",
                  "format",
                  "table",
                  "source_document_id",
                  "source_excerpt"
                ],
                "properties": {
                  "kind": {
                    "const": "workspace_file"
                  },
                  "relative_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "csv",
                      "tsv",
                      "pipe_table"
                    ]
                  },
                  "table": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "source_document_id": {
                    "type": "string",
                    "pattern": "^refdoc:[0-9a-f]{64}$"
                  },
                  "source_excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "selectors": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "reference_id",
                "selector"
              ],
              "properties": {
                "reference_id": {
                  "type": "string",
                  "pattern": "^refmetric:[0-9a-f]{64}$"
                },
                "selector": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "json_pointer"
                      ],
                      "properties": {
                        "json_pointer": {
                          "type": "string",
                          "maxLength": 2048
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "column"
                      ],
                      "properties": {
                        "column": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "target",
          "reason"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
