{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "source_kind",
    "repository",
    "requested_revision",
    "resolved_commit_sha",
    "workspace_relative_path",
    "documents",
    "read_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "openair-reference-source-package/v1"
    },
    "state": {
      "const": "succeeded"
    },
    "source_kind": {
      "const": "official_repository"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "requested_revision": {
      "type": "string",
      "minLength": 1
    },
    "resolved_commit_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "workspace_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "path",
          "sha256",
          "line_count",
          "content"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^refdoc:[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 49152
          }
        },
        "additionalProperties": false
      }
    },
    "read_evidence": {
      "type": "object",
      "required": [
        "git_version",
        "verified_head",
        "head_matches_upstream_artifact",
        "candidate_document_count",
        "included_document_count",
        "total_included_bytes"
      ],
      "properties": {
        "git_version": {
          "type": "string",
          "minLength": 1
        },
        "verified_head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "head_matches_upstream_artifact": {
          "const": true
        },
        "candidate_document_count": {
          "type": "integer",
          "minimum": 1
        },
        "included_document_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "total_included_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
