{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "assembly_status",
    "reference_metric_records",
    "reference_metric_comparison_requests",
    "reference_metric_source_conflicts",
    "reference_metric_unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "openair-reference-metrics/v1"
    },
    "assembly_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "reference_metric_records": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "reference_id",
          "metric_name",
          "reference_value",
          "value_type",
          "unit",
          "experiment_conditions",
          "source",
          "comparison_rule_status",
          "comparison_rule"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^refmetric:[0-9a-f]{64}$"
          },
          "metric_name": {
            "type": "string",
            "minLength": 1
          },
          "reference_value": {
            "type": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          },
          "value_type": {
            "type": "string",
            "enum": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "experiment_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "required": [
              "source_kind",
              "repository",
              "resolved_commit_sha",
              "document_id",
              "path",
              "sha256",
              "locator"
            ],
            "properties": {
              "source_kind": {
                "const": "official_repository"
              },
              "repository": {
                "type": "string"
              },
              "resolved_commit_sha": {
                "type": "string"
              },
              "document_id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "locator": {
                "type": "object",
                "required": [
                  "line_start",
                  "line_end",
                  "excerpt"
                ],
                "properties": {
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line_end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "excerpt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "x-execution-critical": true
              }
            },
            "additionalProperties": false
          },
          "comparison_rule_status": {
            "type": "string",
            "enum": [
              "provided",
              "missing"
            ]
          },
          "comparison_rule": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "basis"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "tolerance": {
                    "type": "number"
                  },
                  "basis": {
                    "type": "object",
                    "required": [
                      "document_id",
                      "path",
                      "line_start",
                      "line_end",
                      "excerpt"
                    ],
                    "properties": {
                      "document_id": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "line_start": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "line_end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "excerpt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "reference_metric_comparison_requests": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "metric_name",
          "reference_value",
          "value_type",
          "unit",
          "comparison_rule"
        ],
        "properties": {
          "metric_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reference_value": {
            "type": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          },
          "value_type": {
            "type": "string",
            "enum": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "comparison_rule": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "exact",
                  "absolute_tolerance",
                  "relative_tolerance",
                  "actual_gte_reference",
                  "actual_lte_reference"
                ]
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "reference_metric_source_conflicts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "metric_name",
          "reference_ids",
          "reason"
        ],
        "properties": {
          "metric_name": {
            "type": "string"
          },
          "reference_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "const": "conflicting_reference_facts"
          }
        },
        "additionalProperties": false
      }
    },
    "reference_metric_unresolved": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "target",
          "reason"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
