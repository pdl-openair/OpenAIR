{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "source_package",
    "interpretation"
  ],
  "properties": {
    "source_package": {
      "type": "object",
      "required": [
        "schema_version",
        "state",
        "source_kind",
        "repository",
        "resolved_commit_sha",
        "documents"
      ],
      "properties": {
        "schema_version": {
          "const": "openair-reference-source-package/v1"
        },
        "state": {
          "const": "succeeded"
        },
        "source_kind": {
          "const": "official_repository"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "resolved_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/document"
          }
        }
      },
      "additionalProperties": true
    },
    "interpretation": {
      "type": "object",
      "required": [
        "reference_candidates",
        "unresolved"
      ],
      "properties": {
        "reference_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/candidate"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "target",
              "reason"
            ],
            "properties": {
              "target": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "document": {
      "type": "object",
      "required": [
        "document_id",
        "path",
        "sha256",
        "content"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "rule": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact",
            "absolute_tolerance",
            "relative_tolerance",
            "actual_gte_reference",
            "actual_lte_reference"
          ]
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "metric_name",
        "reference_value",
        "value_type",
        "unit",
        "experiment_conditions",
        "source_document_id",
        "source_excerpt",
        "comparison_rule",
        "comparison_rule_basis_excerpt"
      ],
      "properties": {
        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "reference_value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean"
          ]
        },
        "value_type": {
          "enum": [
            "number",
            "integer",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "experiment_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_document_id": {
          "type": "string",
          "minLength": 1
        },
        "source_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "comparison_rule": {
          "$ref": "#/definitions/rule"
        },
        "comparison_rule_basis_excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
