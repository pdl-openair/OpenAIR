{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "reproduction_experiment_design",
    "execution_plan_facts",
    "execution_readiness_record",
    "code_identity",
    "environment_record"
  ],
  "properties": {
    "reproduction_experiment_design": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ready"
        }
      },
      "additionalProperties": true
    },
    "execution_plan_facts": {
      "type": "object",
      "required": [
        "schema_version",
        "state",
        "plan_status",
        "execution_plan_id",
        "source_identity",
        "resource_acquisition_requests",
        "execution_resource_binding_plan",
        "executable",
        "argv",
        "working_directory",
        "timeout_seconds",
        "actual_metric_result_source",
        "actual_metric_requests"
      ],
      "properties": {
        "schema_version": {
          "const": "openair-execution-plan/v1"
        },
        "state": {
          "const": "succeeded"
        },
        "plan_status": {
          "const": "complete"
        },
        "execution_plan_id": {
          "type": "string",
          "pattern": "^execplan:[0-9a-f]{64}$"
        },
        "source_identity": {
          "type": "object"
        },
        "resource_acquisition_requests": {
          "type": "array"
        },
        "execution_resource_binding_plan": {
          "type": "array",
          "maxItems": 2
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "environment_variables": {
          "type": "object"
        },
        "actual_metric_result_source": {
          "type": "object"
        },
        "actual_metric_requests": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "execution_readiness_record": {
      "type": "object",
      "required": [
        "status",
        "blocking_gaps",
        "executable_scope"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "blocking_gaps": {
          "type": "array",
          "maxItems": 0
        },
        "executable_scope": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "code_identity": {
      "type": "object",
      "required": [
        "state",
        "repository",
        "requested_revision",
        "resolved_commit_sha",
        "verified_head",
        "workspace_relative_path"
      ],
      "properties": {
        "state": {
          "const": "succeeded"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "requested_revision": {
          "type": "string",
          "minLength": 1
        },
        "resolved_commit_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "verified_head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "workspace_relative_path": {
          "const": "repository"
        }
      },
      "additionalProperties": true
    },
    "resource_identities": {
      "type": "object",
      "required": [
        "state",
        "resources"
      ],
      "properties": {
        "state": {
          "const": "succeeded"
        },
        "resources": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "environment_record": {
      "type": "object",
      "required": [
        "schema_version",
        "state",
        "workspace_relative_path",
        "environment_record_relative_path",
        "environment_identity"
      ],
      "properties": {
        "schema_version": {
          "const": "openair-environment-record/v1"
        },
        "state": {
          "const": "succeeded"
        },
        "workspace_relative_path": {
          "const": "environment"
        },
        "environment_record_relative_path": {
          "const": "environment/environment-record.json"
        },
        "environment_identity": {
          "type": "object",
          "required": [
            "fingerprint_sha256"
          ],
          "properties": {
            "fingerprint_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
