{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "source_package",
    "interpretation",
    "reference_metrics"
  ],
  "properties": {
    "source_package": {
      "type": "object",
      "required": [
        "schema_version",
        "state",
        "source_kind",
        "repository",
        "resolved_commit_sha",
        "workspace_relative_path",
        "documents"
      ],
      "properties": {
        "schema_version": {
          "const": "openair-reference-source-package/v1"
        },
        "state": {
          "const": "succeeded"
        },
        "source_kind": {
          "const": "official_repository"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "resolved_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workspace_relative_path": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12
        }
      },
      "additionalProperties": true
    },
    "interpretation": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": true
    },
    "reference_metrics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "reference_id",
          "metric_name",
          "value_type",
          "unit"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^refmetric:[0-9a-f]{64}$"
          },
          "metric_name": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "enum": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
