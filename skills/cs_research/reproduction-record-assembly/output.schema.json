{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "record_status",
    "reproduction_result",
    "missing_components",
    "code_identity",
    "resource_identities",
    "resource_usage_verification",
    "environment",
    "execution",
    "actual_metrics",
    "reference_comparison"
  ],
  "properties": {
    "schema_version": {
      "const": "openair-reproduction-record/v1"
    },
    "state": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "record_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "reproduction_result": {
      "type": "string",
      "enum": [
        "meets_standard",
        "does_not_meet_standard",
        "indeterminate"
      ]
    },
    "failure_code": {
      "type": "string",
      "minLength": 1
    },
    "missing_components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "code_identity",
          "source_evidence",
          "environment_record",
          "execution_record",
          "resource_usage_evidence",
          "actual_metrics",
          "reference_comparison"
        ]
      }
    },
    "code_identity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "repository",
            "requested_revision",
            "resolved_commit_sha",
            "verified_head",
            "workspace_relative_path"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "requested_revision": {
              "type": "string",
              "minLength": 1
            },
            "resolved_commit_sha": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "verified_head": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "workspace_relative_path": {
              "const": "repository"
            },
            "source_evidence": {
              "$ref": "../repository-revision-acquisition/input.schema.json#/properties/source_evidence"
            },
            "source_evidence_review": {
              "type": "object",
              "required": [
                "status",
                "issues",
                "received"
              ],
              "properties": {
                "status": {
                  "const": "unverified"
                },
                "issues": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "content_form_unsupported",
                      "repository_url_missing"
                    ]
                  }
                },
                "received": {
                  "$ref": "input.schema.json#/definitions/receivedSourceEvidence"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true,
          "not": {
            "required": [
              "source_evidence",
              "source_evidence_review"
            ]
          }
        }
      ]
    },
    "resource_identities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resource_usage_verification": {
      "type": "object",
      "required": [
        "status",
        "resource_checks"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "not_applicable",
            "verified",
            "missing_evidence",
            "mismatch",
            "not_evaluated"
          ]
        },
        "resource_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repo_id",
              "repo_type",
              "resolved_commit_sha",
              "usage",
              "status"
            ],
            "properties": {
              "repo_id": {
                "type": "string",
                "minLength": 1
              },
              "repo_type": {
                "type": "string",
                "enum": [
                  "model",
                  "dataset"
                ]
              },
              "resolved_commit_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "usage": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "model",
                  "dataset",
                  null
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "missing_evidence",
                  "mismatch"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution": {
      "type": [
        "object",
        "null"
      ]
    },
    "actual_metrics": {
      "type": [
        "object",
        "null"
      ]
    },
    "reference_comparison": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
