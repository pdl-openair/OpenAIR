{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["research_goal", "source_package"],
  "properties": {
    "research_goal": {"type": "string", "minLength": 1, "maxLength": 8000},
    "source_package": {
      "type": "object",
      "required": ["schema_version", "state", "source_kind", "repository", "requested_revision", "resolved_commit_sha", "documents"],
      "properties": {
        "schema_version": {"const": "openair-reference-source-package/v1"},
        "state": {"const": "succeeded"},
        "source_kind": {"const": "official_repository"},
        "repository": {"type": "string"},
        "requested_revision": {"type": "string"},
        "resolved_commit_sha": {"type": "string"},
        "documents": {"type": "array", "minItems": 1, "maxItems": 24}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
