{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["reference_candidates", "unresolved"],
  "properties": {
    "reference_candidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "metric_name",
          "reference_value",
          "value_type",
          "unit",
          "experiment_conditions",
          "source_document_id",
          "source_excerpt",
          "comparison_rule",
          "comparison_rule_basis_excerpt"
        ],
        "properties": {
          "metric_name": {"type": "string", "minLength": 1, "maxLength": 256},
          "reference_value": {"type": ["number", "integer", "string", "boolean"]},
          "value_type": {"type": "string", "enum": ["number", "integer", "string", "boolean"]},
          "unit": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "experiment_conditions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "source_document_id": {"type": "string", "pattern": "^refdoc:[0-9a-f]{64}$"},
          "source_excerpt": {"type": "string", "minLength": 1, "maxLength": 4096},
          "comparison_rule": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["exact", "absolute_tolerance", "relative_tolerance", "actual_gte_reference", "actual_lte_reference"]
                  },
                  "tolerance": {"type": "number", "minimum": 0}
                },
                "additionalProperties": false
              }
            ]
          },
          "comparison_rule_basis_excerpt": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["target", "reason"],
        "properties": {
          "target": {"type": "string", "minLength": 1, "maxLength": 512},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
