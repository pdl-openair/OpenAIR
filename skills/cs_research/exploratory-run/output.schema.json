{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "execution_status",
    "actual_executable",
    "argv",
    "working_directory",
    "environment",
    "environment_variable_names",
    "started_at_utc",
    "ended_at_utc",
    "duration_seconds",
    "exit_code",
    "timed_out",
    "stdout",
    "stderr",
    "execution_record_relative_path"
  ],
  "properties": {
    "schema_version": {"const": "openair-execution-record/v1"},
    "state": {"type": "string", "enum": ["succeeded", "failed"]},
    "execution_status": {
      "type": "string",
      "enum": ["succeeded", "process_start_failed", "non_zero_exit", "timeout", "termination_failed"]
    },
    "failure_code": {
      "type": "string",
      "enum": ["process_start_failed", "non_zero_exit", "execution_timeout", "process_termination_failed"]
    },
    "actual_executable": {"type": "string", "pattern": "^environment/.+"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "working_directory": {"type": "string", "minLength": 1},
    "environment": {
      "type": "object",
      "required": ["workspace_relative_path", "environment_record_relative_path", "fingerprint_sha256"],
      "properties": {
        "workspace_relative_path": {"const": "environment"},
        "environment_record_relative_path": {"const": "environment/environment-record.json"},
        "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "environment_variable_names": {"type": "array", "items": {"type": "string"}},
    "resource_usage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/definitions/resourceUsage"}
    },
    "started_at_utc": {"type": "string", "minLength": 1},
    "ended_at_utc": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "process_id": {"type": "integer", "minimum": 1},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "stdout": {"$ref": "#/definitions/capture"},
    "stderr": {"$ref": "#/definitions/capture"},
    "process_start_error": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "termination_evidence": {"type": "object"},
    "execution_record_relative_path": {"type": "string", "pattern": "^execution/.+/execution-record\\.json$"}
  },
  "definitions": {
    "capture": {
      "type": "object",
      "required": ["text", "total_bytes", "captured_bytes", "truncated", "stream_complete"],
      "properties": {
        "text": {"type": "string"},
        "total_bytes": {"type": "integer", "minimum": 0},
        "captured_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "truncated": {"type": "boolean"},
        "stream_complete": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "immutableIdentity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "commit_sha"],
          "properties": {
            "kind": {"const": "huggingface_commit"},
            "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "commit_sha", "filename", "sha256"],
          "properties": {
            "kind": {"const": "huggingface_file_at_commit"},
            "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "filename": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "resourceProjection": {
      "type": "object",
      "required": ["resource_kind", "repo_id", "repo_type", "resolved_commit_sha", "actual_identity", "workspace_relative_path"],
      "properties": {
        "resource_kind": {"type": "string", "enum": ["huggingface_snapshot", "huggingface_file"]},
        "repo_id": {"type": "string", "minLength": 1},
        "repo_type": {"type": "string", "enum": ["model", "dataset"]},
        "resolved_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "actual_identity": {"$ref": "#/definitions/immutableIdentity"},
        "workspace_relative_path": {"type": "string", "pattern": "^resource(?:/.*)?$"}
      },
      "additionalProperties": false
    },
    "consumptionEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "receipt_relative_path", "sha256"],
          "properties": {
            "kind": {"const": "workspace_json_receipt"},
            "receipt_relative_path": {"type": "string", "pattern": "^execution/.+/resource-consumption/(model|dataset)\\.json$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "receipt_relative_path", "sha256", "accessed_workspace_relative_path"],
          "properties": {
            "kind": {"const": "controlled_python_file_open_read"},
            "receipt_relative_path": {"type": "string", "pattern": "^execution/.+/resource-consumption/(model|dataset)\\.json$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "accessed_workspace_relative_path": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "resourceUsage": {
      "type": "object",
      "required": ["usage", "planned_resource", "delivery", "verification"],
      "properties": {
        "usage": {"type": "string", "enum": ["model", "dataset"]},
        "planned_resource": {"$ref": "#/definitions/resourceProjection"},
        "delivery": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "argument_index"],
              "properties": {
                "kind": {"const": "argv_path"},
                "argument_index": {"type": "integer", "minimum": 0, "maximum": 255}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "target_working_directory", "archive_sha256", "manifest_sha256", "manifest_relative_path", "member_count", "file_count", "total_file_bytes"],
              "properties": {
                "kind": {"const": "tar_extract_working_directory"},
                "target_working_directory": {"type": "string", "minLength": 1},
                "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "manifest_relative_path": {"type": "string", "pattern": "^execution/.+/resource-delivery/(model|dataset)\\.json$"},
                "member_count": {"type": "integer", "minimum": 1, "maximum": 20000},
                "file_count": {"type": "integer", "minimum": 1, "maximum": 20000},
                "total_file_bytes": {"type": "integer", "minimum": 0, "maximum": 2147483648}
              },
              "additionalProperties": false
            }
          ]
        },
        "actual_usage": {
          "type": "object",
          "required": ["workspace_relative_path", "immutable_identity"],
          "properties": {
            "workspace_relative_path": {"type": "string", "pattern": "^resource(?:/.*)?$"},
            "immutable_identity": {"$ref": "#/definitions/immutableIdentity"},
            "observed_access": {
              "type": "object",
              "required": ["kind", "workspace_relative_path"],
              "properties": {
                "kind": {"const": "python_file_open_read"},
                "workspace_relative_path": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "consumption_evidence": {"$ref": "#/definitions/consumptionEvidence"},
        "verification": {"type": "string", "enum": ["unverified", "verified", "mismatch"]}
      },
      "allOf": [
        {
          "if": {"properties": {"verification": {"const": "unverified"}}},
          "then": {"not": {"anyOf": [{"required": ["actual_usage"]}, {"required": ["consumption_evidence"]}]}}
        },
        {
          "if": {"properties": {"verification": {"const": "verified"}}},
          "then": {"required": ["actual_usage", "consumption_evidence"]}
        },
        {
          "if": {"properties": {"verification": {"const": "mismatch"}}},
          "then": {"required": ["consumption_evidence"]}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
