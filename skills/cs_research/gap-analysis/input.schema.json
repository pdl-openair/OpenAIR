{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GapAnalysisInput",
  "type": "object",
  "required": [
    "source_materials",
    "gap_focus_types"
  ],
  "additionalProperties": true,
  "properties": {
    "source_materials": {
      "type": "array",
      "minItems": 1,
      "description": "可复核上游材料：综述草稿、文献笔记、来源表、证据表、claim-evidence 表、机制图，或候选论文摘要/全文摘录等。",
      "items": {
        "type": "object",
        "required": ["material_id", "material_type", "content"],
        "additionalProperties": true,
        "properties": {
          "material_id": { "type": "string" },
          "material_type": {
            "type": "string",
            "enum": [
              "review_draft",
              "literature_notes",
              "source_table",
              "evidence_table",
              "claim_evidence_table",
              "mechanism_map",
              "paper_excerpt",
              "experiment_record",
              "viewpoint_comparison"
            ]
          },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gap_focus_types": {
      "type": "array",
      "description": "用户指定的空缺关注类型。",
      "items": {
        "type": "string",
        "enum": [
          "theoretical_gap",
          "method_gap",
          "data_gap",
          "validation_gap",
          "application_gap",
          "reproducibility_gap"
        ]
      }
    },
    "scope_notes": {
      "type": "string",
      "description": "可选范围说明；仅 topic/关键词不足以进入空缺识别。"
    }
  }
}
