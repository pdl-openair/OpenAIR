{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["user_goal", "candidates"],
  "properties": {
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "stage": { "type": "string" },
    "user_goal": {
      "type": "string",
      "description": "评估目标，如筛选最优采样策略或对比轨迹质量"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
