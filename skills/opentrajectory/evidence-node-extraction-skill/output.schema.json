{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evidence-node-extraction ResearchRecord output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_records",
    "schema_id",
    "summary",
    "audit",
    "extraction_warnings"
  ],
  "properties": {
    "research_records": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "source",
          "source_anchor_id",
          "record_type",
          "research_object",
          "condition_status",
          "conditions",
          "result",
          "information_identity",
          "assertion_mode",
          "source_quote",
          "qualifiers",
          "uncertainty",
          "unknown_fields",
          "relevant_target_ids"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^rr:[0-9a-f]{32}$",
            "readOnly": true
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "readOnly": true,
            "required": [
              "candidate_id",
              "anchor_id",
              "title",
              "doi",
              "arxiv_id",
              "provider",
              "source_locator",
              "section_name",
              "content_hash",
              "source_type",
              "provenance"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1,
                "readOnly": true
              },
              "anchor_id": {
                "type": "string",
                "minLength": 1,
                "readOnly": true
              },
              "title": {
                "type": "string",
                "readOnly": true
              },
              "doi": {
                "type": "string",
                "readOnly": true
              },
              "arxiv_id": {
                "type": "string",
                "readOnly": true
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "readOnly": true
              },
              "source_locator": {
                "type": "string",
                "minLength": 1,
                "readOnly": true,
                "x-execution-critical": true
              },
              "section_name": {
                "type": "string",
                "minLength": 1,
                "readOnly": true
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "readOnly": true
              },
              "source_type": {
                "type": "string",
                "minLength": 1,
                "readOnly": true
              },
              "provenance": {
                "type": "array",
                "readOnly": true
              }
            }
          },
          "source_anchor_id": {
            "type": "string",
            "minLength": 1
          },
          "record_type": {
            "type": "string",
            "enum": [
              "material_composition",
              "experimental_condition",
              "quantitative_result",
              "characterization_observation",
              "computation_result",
              "comparison",
              "mechanism_statement",
              "limitation",
              "qualitative_result"
            ]
          },
          "research_object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "condition_status": {
            "type": "string",
            "enum": [
              "reported",
              "partially_unknown",
              "not_applicable"
            ]
          },
          "conditions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status",
                "value_text",
                "unit"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "reported",
                    "unknown"
                  ]
                },
                "value_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "reported"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value_text": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "unknown"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value_text": {
                        "type": "null"
                      },
                      "unit": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "values",
              "mechanism",
              "comparison"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "values": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value_text",
                    "unit"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value_text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "mechanism": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cause",
                      "effect"
                    ],
                    "properties": {
                      "cause": {
                        "type": "string",
                        "minLength": 1
                      },
                      "effect": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "comparison": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "subject",
                      "baseline",
                      "dimension",
                      "relation",
                      "condition_text"
                    ],
                    "properties": {
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      },
                      "baseline": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dimension": {
                        "type": "string",
                        "minLength": 1
                      },
                      "relation": {
                        "type": "string",
                        "enum": [
                          "higher",
                          "lower",
                          "equal",
                          "different",
                          "better",
                          "worse",
                          "increase",
                          "decrease",
                          "other"
                        ]
                      },
                      "condition_text": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxItems": 12
                      }
                    }
                  }
                ]
              }
            }
          },
          "information_identity": {
            "type": "string",
            "enum": [
              "direct_source_fact",
              "author_interpretation",
              "other_source_information"
            ]
          },
          "assertion_mode": {
            "type": "string",
            "enum": [
              "direct_observation",
              "association",
              "causal_claim",
              "author_interpretation",
              "source_statement"
            ]
          },
          "source_quote": {
            "type": "string",
            "minLength": 12,
            "maxLength": 1800
          },
          "qualifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 16
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 800
          },
          "unknown_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "maxItems": 16
          },
          "relevant_target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^target_[0-9]{3}$"
            },
            "uniqueItems": true,
            "maxItems": 40
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "condition_status": {
                  "const": "reported"
                }
              }
            },
            "then": {
              "properties": {
                "conditions": {
                  "minItems": 1,
                  "items": {
                    "allOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "status",
                          "value_text",
                          "unit"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "reported",
                              "unknown"
                            ]
                          },
                          "value_text": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "unit": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "status": {
                                  "const": "reported"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value_text": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          },
                          {
                            "if": {
                              "properties": {
                                "status": {
                                  "const": "unknown"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value_text": {
                                  "type": "null"
                                },
                                "unit": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        ]
                      },
                      {
                        "properties": {
                          "status": {
                            "const": "reported"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "condition_status": {
                  "const": "partially_unknown"
                }
              }
            },
            "then": {
              "properties": {
                "conditions": {
                  "minItems": 1,
                  "contains": {
                    "properties": {
                      "status": {
                        "const": "unknown"
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "condition_status": {
                  "const": "not_applicable"
                }
              }
            },
            "then": {
              "properties": {
                "conditions": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "record_type": {
                  "enum": [
                    "quantitative_result",
                    "computation_result"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "values": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "record_type": {
                  "const": "comparison"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "comparison": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "record_type": {
                  "const": "mechanism_statement"
                }
              }
            },
            "then": {
              "properties": {
                "result": {
                  "properties": {
                    "mechanism": {
                      "type": "object"
                    }
                  }
                },
                "assertion_mode": {
                  "enum": [
                    "causal_claim",
                    "author_interpretation"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "assertion_mode": {
                  "const": "direct_observation"
                }
              }
            },
            "then": {
              "properties": {
                "information_identity": {
                  "const": "direct_source_fact"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "assertion_mode": {
                  "const": "author_interpretation"
                }
              }
            },
            "then": {
              "properties": {
                "information_identity": {
                  "const": "author_interpretation"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "assertion_mode": {
                  "enum": [
                    "association",
                    "causal_claim"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "information_identity": {
                  "const": "other_source_information"
                }
              }
            }
          }
        ]
      }
    },
    "schema_id": {
      "type": [
        "string",
        "null"
      ],
      "readOnly": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "readOnly": true,
      "required": [
        "status",
        "input_paper_packet_count",
        "input_source_anchor_count",
        "research_record_count",
        "record_type_counts",
        "dropped_duplicate_count",
        "dropped_invalid_count",
        "uncovered_required_target_ids",
        "degraded"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "partial",
            "degraded"
          ]
        },
        "input_paper_packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "input_source_anchor_count": {
          "type": "integer",
          "minimum": 0
        },
        "research_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "record_type_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dropped_duplicate_count": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_required_target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^target_[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "degraded": {
          "type": "boolean"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "readOnly": true,
      "required": [
        "skill_id",
        "traceability_mode",
        "finalizer_version",
        "input_fingerprint",
        "supported_record_types"
      ],
      "properties": {
        "skill_id": {
          "const": "evidence_node_extraction"
        },
        "traceability_mode": {
          "const": "research_record_source_anchor_quote_finalizer"
        },
        "finalizer_version": {
          "type": "string",
          "minLength": 1
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "supported_record_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "extraction_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 100,
      "readOnly": true
    }
  }
}
