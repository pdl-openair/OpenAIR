{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "deepxiv-progressive-reading output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "paper_packets",
    "material_attempts",
    "summary",
    "audit"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "degraded",
        "failed"
      ]
    },
    "paper_packets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/paper_packet"
      },
      "maxItems": 12
    },
    "material_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "candidate_id",
          "reason",
          "provider_attempted"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "provider_attempted": {
            "type": "string",
            "minLength": 1
          },
          "diagnostics": {
            "type": "object"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_candidate_count",
        "attempted_candidate_count",
        "truncated_candidate_count",
        "paper_packet_count",
        "ready_packet_count",
        "abstract_only_packet_count",
        "failed_candidate_count",
        "material_attempt_count",
        "section_count",
        "source_anchor_count",
        "partial_success",
        "degraded"
      ],
      "properties": {
        "input_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "attempted_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "paper_packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "ready_packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "abstract_only_packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "material_attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "section_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_anchor_count": {
          "type": "integer",
          "minimum": 0
        },
        "partial_success": {
          "type": "boolean"
        },
        "degraded": {
          "type": "boolean"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "reader_mode",
        "raw_default_enabled",
        "raw_call_count",
        "max_papers",
        "max_sections_per_paper",
        "network_timeout_seconds",
        "max_provider_retries",
        "max_total_chars",
        "output_content_chars",
        "section_priority",
        "input_fingerprint"
      ],
      "properties": {
        "skill_id": {
          "const": "deepxiv_progressive_reading"
        },
        "reader_mode": {
          "type": "string",
          "enum": [
            "deepxiv_sdk_reader",
            "mixed_deepxiv_and_fulltext"
          ]
        },
        "raw_default_enabled": {
          "type": "boolean"
        },
        "raw_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_papers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_sections_per_paper": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "network_timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 60
        },
        "max_provider_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_total_chars": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 2000000
        },
        "output_content_chars": {
          "type": "integer",
          "minimum": 0
        },
        "section_priority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "doi",
        "arxiv_id",
        "arxiv_work_id",
        "arxiv_version",
        "pmcid",
        "openalex_id",
        "title"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "arxiv_id": {
          "type": "string"
        },
        "arxiv_work_id": {
          "type": "string"
        },
        "arxiv_version": {
          "type": "string"
        },
        "pmcid": {
          "type": "string"
        },
        "openalex_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "observed_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doi",
        "arxiv_id",
        "arxiv_work_id",
        "arxiv_version",
        "pmcid",
        "openalex_id"
      ],
      "properties": {
        "doi": {
          "type": "string"
        },
        "arxiv_id": {
          "type": "string"
        },
        "arxiv_work_id": {
          "type": "string"
        },
        "arxiv_version": {
          "type": "string"
        },
        "pmcid": {
          "type": "string"
        },
        "openalex_id": {
          "type": "string"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_name",
        "content",
        "content_hash",
        "source_type",
        "provider",
        "source_locator",
        "paper_identity",
        "material_type",
        "material_status"
      ],
      "properties": {
        "section_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "paper_identity": {
          "oneOf": [
            {
              "$ref": "#/definitions/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_type": {
          "type": "string",
          "enum": [
            "article_fulltext",
            "abstract_only"
          ]
        },
        "material_status": {
          "type": "string",
          "enum": [
            "MATERIAL_READY",
            "ABSTRACT_ONLY"
          ]
        }
      },
      "$comment": "content_hash must equal SHA-256(content). Within one paper packet, (section_name, content_hash) is a deterministic section identity and must not be duplicated."
    },
    "source_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "candidate_id",
        "arxiv_id",
        "section_name",
        "content_hash",
        "source_type",
        "provider",
        "source_locator"
      ],
      "properties": {
        "anchor_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "arxiv_id": {
          "type": "string"
        },
        "section_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "$comment": "Within one extraction input, anchor_id is unique. Each anchor candidate_id must equal its packet candidate_id; its (section_name, content_hash) must identify one section in that packet; source_type must agree with that section. These cross-object relationships and content hashes are verified deterministically at runtime."
    },
    "paper_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "arxiv_id",
        "doi",
        "title",
        "read_depth",
        "reading_mode",
        "brief",
        "head",
        "sections",
        "source_anchors",
        "material_status",
        "material_type",
        "requested_identity",
        "provider_observed_identity",
        "resolved_identity",
        "paper_identity",
        "provider",
        "source_locator",
        "provider_observed_title",
        "provenance",
        "tables",
        "diagnostics"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "arxiv_id": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "read_depth": {
          "type": "string",
          "enum": [
            "section",
            "raw_fallback",
            "html_fulltext",
            "pdf_fulltext",
            "abstract_only"
          ]
        },
        "reading_mode": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "brief": {},
        "head": {},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/section"
          },
          "$comment": "Section identities are unique by (section_name, content_hash) within the packet."
        },
        "source_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source_anchor"
          },
          "$comment": "Anchors must reference this packet and one of its section identities; anchor_id is a stable unique identity."
        },
        "material_status": {
          "type": "string",
          "enum": [
            "MATERIAL_READY",
            "ABSTRACT_ONLY"
          ]
        },
        "material_type": {
          "type": "string",
          "enum": [
            "article_fulltext",
            "abstract_only"
          ]
        },
        "requested_identity": {
          "$ref": "#/definitions/identity"
        },
        "provider_observed_identity": {
          "oneOf": [
            {
              "$ref": "#/definitions/observed_identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_identity": {
          "oneOf": [
            {
              "$ref": "#/definitions/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "paper_identity": {
          "oneOf": [
            {
              "$ref": "#/definitions/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider_observed_title": {
          "type": "string"
        },
        "provenance": {
          "type": "array"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "evidence_schema_id",
            "evidence_schema_version",
            "target_reading"
          ],
          "properties": {
            "evidence_schema_id": {
              "type": "string",
              "minLength": 1
            },
            "evidence_schema_version": {
              "const": "0.1.0"
            },
            "target_reading": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "$ref": "#/definitions/target_reading_result"
              }
            }
          }
        }
      }
    },
    "target_reading_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_type",
        "scientific_role",
        "requiredness",
        "status",
        "matched_cues",
        "missing_cues",
        "source_anchor_ids"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^target_[0-9]{3}$"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "entity",
            "relation",
            "attribute",
            "experimental_condition",
            "performance_metric",
            "mechanism_evidence",
            "characterization_observation",
            "theoretical_calculation",
            "comparison_baseline",
            "limitation",
            "provenance",
            "other"
          ]
        },
        "scientific_role": {
          "type": "string",
          "enum": [
            "composition",
            "condition",
            "metric",
            "mechanism",
            "characterization",
            "theoretical_explanation",
            "baseline",
            "comparability",
            "limitation",
            "provenance",
            "other"
          ]
        },
        "requiredness": {
          "type": "string",
          "enum": [
            "required",
            "preferred",
            "optional"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "located_in_read_content",
            "unresolved"
          ]
        },
        "matched_cues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missing_cues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_anchor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
