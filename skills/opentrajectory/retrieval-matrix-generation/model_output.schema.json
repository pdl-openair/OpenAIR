{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "retrieval-matrix-generation model semantic draft",
  "type": "object",
  "required": [
    "strategies",
    "expanded_query_variants",
    "facets"
  ],
  "properties": {
    "strategies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "search_intent",
          "query_terms",
          "must_include_terms",
          "optional_terms",
          "exclude_terms",
          "expected_paper_type",
          "target_database",
          "source_constraints",
          "rationale",
          "priority"
        ],
        "properties": {
          "search_intent": {
            "$ref": "#/$defs/search_intent"
          },
          "query_terms": {
            "$ref": "#/$defs/terms_5"
          },
          "must_include_terms": {
            "$ref": "#/$defs/terms_3"
          },
          "optional_terms": {
            "$ref": "#/$defs/terms_6"
          },
          "exclude_terms": {
            "$ref": "#/$defs/terms_8"
          },
          "expected_paper_type": {
            "type": "string",
            "maxLength": 240
          },
          "target_database": {
            "type": "string",
            "maxLength": 240
          },
          "source_constraints": {
            "$ref": "#/$defs/source_constraints"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "priority": {
            "$ref": "#/$defs/priority"
          }
        },
        "additionalProperties": false
      }
    },
    "expanded_query_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "query",
          "variant_type",
          "search_intent",
          "source_constraints",
          "rationale",
          "priority"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "variant_type": {
            "type": "string",
            "enum": [
              "strict",
              "broad",
              "fallback",
              "exclusion"
            ]
          },
          "search_intent": {
            "$ref": "#/$defs/search_intent"
          },
          "source_constraints": {
            "$ref": "#/$defs/source_constraints"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "priority": {
            "$ref": "#/$defs/priority"
          }
        },
        "additionalProperties": false
      }
    },
    "facets": {
      "type": "object",
      "required": [
        "core_entities",
        "research_object_en",
        "mechanisms",
        "target_metrics_en",
        "task_context",
        "must_have_terms",
        "nice_to_have_terms",
        "negative_contexts",
        "evaluation_terms"
      ],
      "properties": {
        "core_entities": {
          "$ref": "#/$defs/terms_8"
        },
        "research_object_en": {
          "$ref": "#/$defs/terms_8"
        },
        "mechanisms": {
          "$ref": "#/$defs/terms_8"
        },
        "target_metrics_en": {
          "$ref": "#/$defs/terms_8"
        },
        "task_context": {
          "$ref": "#/$defs/terms_8"
        },
        "must_have_terms": {
          "$ref": "#/$defs/terms_8"
        },
        "nice_to_have_terms": {
          "$ref": "#/$defs/terms_8"
        },
        "negative_contexts": {
          "$ref": "#/$defs/terms_8"
        },
        "evaluation_terms": {
          "$ref": "#/$defs/terms_8"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "search_intent": {
      "type": "string",
      "enum": [
        "core_topic",
        "constraint_focused",
        "mechanism_focused",
        "method_or_strategy",
        "metric_or_performance",
        "adjacent_but_relevant",
        "noise_exclusion"
      ]
    },
    "priority": {
      "anyOf": [
        {
          "type": "integer",
          "const": 1
        },
        {
          "type": "integer",
          "const": 2
        },
        {
          "type": "integer",
          "const": 3
        }
      ]
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "terms_3": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "terms_5": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "terms_6": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "terms_8": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "source_constraints": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  },
  "additionalProperties": false
}
