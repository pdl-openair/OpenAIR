{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenTrajectorySourceAcquisitionOutput",
  "type": "object",
  "required": [
    "task_id",
    "skill_id",
    "candidates",
    "retrieval_report",
    "dedup_report",
    "summary",
    "warnings",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "const": "opentrajectory_source_acquisition"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "title",
          "access_status",
          "available_access_types",
          "preferred_access_type",
          "access_routes",
          "needs_acquisition",
          "provenance"
        ],
        "additionalProperties": true,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "access_status": {
            "type": "string",
            "enum": [
              "structured_fulltext_ready",
              "pdf_ready",
              "landing_page_only",
              "metadata_only",
              "blocked",
              "unknown"
            ]
          },
          "available_access_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred_access_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_routes": {
            "type": "array"
          },
          "needs_acquisition": {
            "type": "boolean"
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      }
    },
    "retrieval_report": {
      "type": "object",
      "required": [
        "source_counts",
        "query_counts",
        "failed_sources",
        "total_candidates",
        "partial_success",
        "fallback_used",
        "risk_flags"
      ],
      "additionalProperties": false,
      "properties": {
        "source_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "query_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "failed_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "total_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "partial_success": {
          "type": "boolean"
        },
        "fallback_used": {
          "type": "boolean"
        },
        "risk_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dedup_report": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total_candidates",
        "structured_fulltext_available_count",
        "pdf_available_count",
        "landing_page_only_count",
        "metadata_only_count",
        "access_blocked_count",
        "needs_acquisition_count"
      ],
      "additionalProperties": false,
      "properties": {
        "total_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "structured_fulltext_available_count": {
          "type": "integer",
          "minimum": 0
        },
        "pdf_available_count": {
          "type": "integer",
          "minimum": 0
        },
        "landing_page_only_count": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_only_count": {
          "type": "integer",
          "minimum": 0
        },
        "access_blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "needs_acquisition_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
