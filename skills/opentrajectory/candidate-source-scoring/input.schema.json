{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "candidate-source-scoring input",
  "type": "object",
  "additionalProperties": false,
  "required": ["screened_candidates", "research_context"],
  "properties": {
    "screened_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "title",
          "screening_decision",
          "screening_reason",
          "relevance_signals",
          "access_status",
          "provenance"
        ],
        "additionalProperties": true,
        "properties": {
          "candidate_id": {"type": "string"},
          "dedupe_key": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "abstract": {"type": ["string", "null"]},
          "source_name": {"type": ["string", "null"]},
          "citation_count": {"type": ["integer", "null"]},
          "year": {"type": ["integer", "null"]},
          "pdf_url": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"]},
          "landing_page_url": {"type": ["string", "null"]},
          "external_ids": {"type": ["object", "null"]},
          "screening_decision": {
            "type": "string",
            "enum": ["include", "exclude", "maybe"]
          },
          "screening_reason": {"type": "string"},
          "relevance_signals": {
            "type": "array",
            "items": {"type": "string"}
          },
          "access_status": {
            "type": "string",
            "enum": [
              "structured_fulltext_ready",
              "pdf_ready",
              "landing_page_only",
              "metadata_only",
              "blocked",
              "unknown"
            ]
          },
          "provenance": {
            "type": "array",
            "items": {"type": "object"}
          }
        }
      }
    },
    "research_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_question"],
      "properties": {
        "research_question": {"type": "string", "minLength": 1},
        "research_objects": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "conditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "results_or_metrics": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "mechanisms": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "comparison_dimensions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "critical_evidence_requirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "negative_signals": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "off_domain_signals": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
