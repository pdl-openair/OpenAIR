{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evidence-supported-findings-synthesis output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "summary",
    "audit",
    "generation_warnings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_finding_key",
          "finding_id",
          "claim_type",
          "statement",
          "epistemic_status",
          "provenance_evidence_ids",
          "basis_mechanism_edge_ids",
          "gap_mechanism_edge_ids",
          "scope_boundary",
          "uncertainties",
          "confidence"
        ],
        "properties": {
          "local_finding_key": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "pattern": "^fd:[0-9a-f]{20}$"
          },
          "claim_type": {
            "const": "evidence_supported_finding"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "epistemic_status": {
            "enum": [
              "supported",
              "uncertain",
              "conflicting",
              "boundary_limited"
            ]
          },
          "provenance_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "basis_mechanism_edge_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^me:[0-9a-f]{20}$"
            }
          },
          "gap_mechanism_edge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^me:[0-9a-f]{20}$"
            }
          },
          "scope_boundary": {
            "type": "string",
            "minLength": 1
          },
          "uncertainties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_mechanism_edge_count",
        "finding_count",
        "status_counts",
        "dropped_duplicate_finding_count",
        "dropped_over_limit_finding_count",
        "max_findings",
        "degraded"
      ],
      "properties": {
        "input_mechanism_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "uncertain",
            "conflicting",
            "boundary_limited"
          ],
          "properties": {
            "supported": {
              "type": "integer",
              "minimum": 0
            },
            "uncertain": {
              "type": "integer",
              "minimum": 0
            },
            "conflicting": {
              "type": "integer",
              "minimum": 0
            },
            "boundary_limited": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dropped_duplicate_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "boolean"
        },
        "dropped_over_limit_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "task_id",
        "traceability_mode",
        "guard_version",
        "input_fingerprint",
        "claim_layer"
      ],
      "properties": {
        "skill_id": {
          "const": "ot_evidence_supported_findings_synthesis"
        },
        "traceability_mode": {
          "const": "basis_edge_evidence_provenance_guard"
        },
        "guard_version": {
          "const": "s1-findings-v2"
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_layer": {
          "const": "evidence_supported_finding"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
