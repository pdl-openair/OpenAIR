{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evidence-supported-findings-synthesis LLM draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "generation_warnings"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "epistemic_status",
          "provenance_evidence_ids",
          "basis_mechanism_edge_ids",
          "gap_mechanism_edge_ids",
          "scope_boundary",
          "uncertainties",
          "confidence"
        ],
        "properties": {
          "statement": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "epistemic_status": {
            "enum": ["supported", "uncertain", "conflicting", "boundary_limited"]
          },
          "provenance_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          },
          "basis_mechanism_edge_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^me:[0-9a-f]{20}$"}
          },
          "gap_mechanism_edge_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^me:[0-9a-f]{20}$"}
          },
          "scope_boundary": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "uncertainties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "generation_warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
    }
  }
}
