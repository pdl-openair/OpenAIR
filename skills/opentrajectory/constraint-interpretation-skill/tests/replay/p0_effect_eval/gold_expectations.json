{
  "version": "p0_effect_eval_v1",
  "notes": [
    "Gold expectations are not exact-output templates. They define must-detect constraints, confidence bands, forbidden behaviors, and scoring anchors.",
    "Skill output should remain JSON-valid and follow output.schema.json."
  ],
  "global_rules": {
    "downstream_search_terms": {
      "must_be_english": true,
      "must_not_contain_cjk": true,
      "should_not_include_original_chinese_phrase": true
    },
    "confidence_bands": {
      "explicit_numerical_with_unit": [
        0.85,
        0.92
      ],
      "qualitative_domain_consensus": [
        0.55,
        0.7
      ],
      "ambiguous_or_subjective": [
        0.3,
        0.5
      ]
    },
    "filter_rules": {
      "ambiguous_conditions_must_not_be_hard_filters": true,
      "methods_or_mechanisms_must_not_be_treated_as_material_filters": true,
      "full_user_query_must_not_be_converted_to_one_constraint": true
    }
  },
  "case_expectations": {
    "battery_001_li_metal_high_voltage_fast_charge": {
      "must_detect": [
        {
          "name_hint": "high voltage",
          "type_hint": "numerical_range",
          "confidence_band": "explicit_numerical_with_unit",
          "must_include_terms": [
            "high voltage",
            "4.5 V"
          ]
        },
        {
          "name_hint": "fast charging rate",
          "type_hint": "numerical_range",
          "confidence_band": "explicit_numerical_with_unit",
          "must_include_terms": [
            "fast charging",
            "2C"
          ]
        },
        {
          "name_hint": "ether-based electrolyte",
          "type_hint": "material_system",
          "confidence_band": "qualitative_domain_consensus",
          "must_include_terms": [
            "ether electrolyte",
            "ether-based electrolyte"
          ]
        }
      ],
      "must_not": [
        "convert SEI, lithium plating, or interphase formation into hard filters unless explicitly stated",
        "include Chinese phrases in downstream_search_terms"
      ],
      "expected_risk_flags": [
        "fast_charging_definition_may_vary",
        "high_voltage_cutoff_context_needed"
      ]
    },
    "battery_002_solid_state_room_temperature": {
      "must_detect": [
        {
          "name_hint": "sulfide solid electrolyte",
          "type_hint": "material_system",
          "confidence_band": "qualitative_domain_consensus",
          "must_include_terms": [
            "sulfide solid electrolyte"
          ]
        },
        {
          "name_hint": "room temperature",
          "type_hint": "condition",
          "confidence_band": "ambiguous_or_subjective",
          "must_include_terms": [
            "room temperature",
            "ambient temperature"
          ]
        },
        {
          "name_hint": "ionic conductivity threshold",
          "type_hint": "numerical_range",
          "confidence_band": "explicit_numerical_with_unit",
          "must_include_terms": [
            "ionic conductivity",
            "10^-3 S/cm"
          ]
        }
      ],
      "must_not": [
        "assume exact room temperature value if not specified",
        "turn interfacial stability into a numerical hard filter"
      ],
      "expected_risk_flags": [
        "room_temperature_value_unspecified",
        "interfacial_stability_metric_ambiguous"
      ]
    },
    "battery_003_sodium_cathode_low_temperature": {
      "must_detect": [
        {
          "name_hint": "sodium-ion layered oxide cathode",
          "type_hint": "material_system",
