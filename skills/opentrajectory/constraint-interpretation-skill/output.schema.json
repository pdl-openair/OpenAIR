{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "interpreted_constraints",
    "quality_report"
  ],
  "properties": {
    "interpreted_constraints": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "constraint_name",
          "original_phrase",
          "constraint_type",
          "interpreted_value",
          "candidate_values",
          "domain_rationale",
          "confidence",
          "needs_user_confirmation",
          "downstream_search_terms",
          "evidence_basis",
          "risk_flags"
        ],
        "properties": {
          "constraint_name": {
            "type": "string",
            "maxLength": 160
          },
          "original_phrase": {
            "type": "string",
            "maxLength": 480
          },
          "constraint_type": {
            "type": "string",
            "maxLength": 120
          },
          "interpreted_value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 320
          },
          "candidate_values": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 180
            }
          },
          "domain_rationale": {
            "type": "string",
            "maxLength": 512
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "needs_user_confirmation": {
            "type": "boolean"
          },
          "downstream_search_terms": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "evidence_basis": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "risk_flags": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 240
            }
          }
        },
        "additionalProperties": false
      }
    },
    "quality_report": {
      "type": "object",
      "required": [
        "confidence",
        "coverage_level",
        "missing_inputs",
        "risk_flags",
        "needs_manual_review"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "coverage_level": {
          "type": "string",
          "enum": [
            "none",
            "partial",
            "moderate",
            "complete"
          ]
        },
        "missing_inputs": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "risk_flags": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "needs_manual_review": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": false
}
