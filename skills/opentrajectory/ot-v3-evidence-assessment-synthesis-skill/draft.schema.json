{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenTrajectory v3 evidence assessment draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["direct_assessment", "evidence_judgments", "conflicts", "limitations", "evidence_gaps", "synthesis_warnings"],
  "properties": {
    "direct_assessment": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence_judgments": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["statement", "disposition", "record_ids", "scope_boundary", "rationale", "confidence"], "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 2400}, "disposition": {"enum": ["supported", "refuted", "limited", "uncertain"]}, "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^rr:[0-9a-f]{32}$"}}, "scope_boundary": {"type": "string", "minLength": 1, "maxLength": 1600}, "rationale": {"type": "string", "minLength": 1, "maxLength": 2400}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "conflicts": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["statement", "record_ids", "implication"], "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 1800}, "record_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^rr:[0-9a-f]{32}$"}}, "implication": {"type": "string", "minLength": 1, "maxLength": 1200}}}},
    "limitations": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1}},
    "evidence_gaps": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["gap", "related_record_ids", "impact"], "properties": {"gap": {"type": "string", "minLength": 1, "maxLength": 1600}, "related_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^rr:[0-9a-f]{32}$"}}, "impact": {"type": "string", "minLength": 1, "maxLength": 1200}}}},
    "synthesis_warnings": {"type": "array", "items": {"type": "string"}}
  }
}
