{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mechanism-chain-synthesis output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mechanism_edges",
    "mechanism_chains",
    "conflicts",
    "gaps",
    "summary",
    "audit",
    "synthesis_warnings"
  ],
  "properties": {
    "mechanism_edges": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_edge_key",
          "edge_id",
          "edge_status",
          "source_node",
          "relation",
          "target_node",
          "evidence_ids",
          "rationale",
          "confidence"
        ],
        "properties": {
          "local_edge_key": {
            "type": "string",
            "minLength": 1
          },
          "edge_id": {
            "type": "string",
            "pattern": "^me:[0-9a-f]{20}$"
          },
          "edge_status": {
            "enum": [
              "support",
              "conflict",
              "gap"
            ]
          },
          "source_node": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_type",
              "label"
            ],
            "properties": {
              "node_type": {
                "enum": [
                  "composition",
                  "condition",
                  "structure",
                  "interphase",
                  "property",
                  "performance",
                  "observation",
                  "calculation",
                  "limitation",
                  "unknown"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "relation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "predicate",
              "description"
            ],
            "properties": {
              "predicate": {
                "enum": [
                  "promotes",
                  "suppresses",
                  "increases",
                  "decreases",
                  "enables",
                  "limits",
                  "associated_with",
                  "contradicts",
                  "reveals_gap"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "target_node": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_type",
              "label"
            ],
            "properties": {
              "node_type": {
                "enum": [
                  "composition",
                  "condition",
                  "structure",
                  "interphase",
                  "property",
                  "performance",
                  "observation",
                  "calculation",
                  "limitation",
                  "unknown"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "mechanism_chains": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_chain_key",
          "chain_id",
          "title",
          "local_edge_keys",
          "edge_ids",
          "chain_summary",
          "confidence"
        ],
        "properties": {
          "local_chain_key": {
            "type": "string",
            "minLength": 1
          },
          "chain_id": {
            "type": "string",
            "pattern": "^mc:[0-9a-f]{20}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "local_edge_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "edge_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^me:[0-9a-f]{20}$"
            }
          },
          "chain_summary": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "evidence_ids",
          "rationale"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "pattern": "^me:[0-9a-f]{20}$"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "evidence_ids",
          "rationale"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "pattern": "^me:[0-9a-f]{20}$"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_evidence_item_count",
        "mechanism_edge_count",
        "mechanism_chain_count",
        "edge_status_counts",
        "dropped_duplicate_edge_count",
        "dropped_duplicate_chain_count",
        "degraded"
      ],
      "properties": {
        "input_evidence_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "mechanism_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "mechanism_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dropped_duplicate_edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_duplicate_chain_count": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "boolean"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "traceability_mode",
        "guard_version",
        "input_fingerprint",
        "allowed_edge_statuses",
        "allowed_predicates"
      ],
      "properties": {
        "skill_id": {
          "const": "mechanism_chain_synthesis"
        },
        "traceability_mode": {
          "const": "evidence_id_guard"
        },
        "guard_version": {
          "const": "p07d-v1"
        },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "allowed_edge_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_predicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "synthesis_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
