{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenTrajectorySourceScreeningSelectionInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "user_query",
    "research_context",
    "candidates"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "user_query": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "research_context": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "evidence_schema": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "$comment": "candidate_id values must be unique within one input batch. JSON Schema cannot express uniqueness by one object property, so the finalizer enforces this deterministic identity invariant before using model judgments."
    }
  },
  "$defs": {
    "Candidate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "candidate_id",
        "title",
        "provenance"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "abstract": {
          "type": ["string", "null"]
        },
        "doi": {
          "type": ["string", "null"]
        },
        "source_url": {
          "type": ["string", "null"]
        },
        "landing_page_url": {
          "type": ["string", "null"]
        },
        "pdf_url": {
          "type": ["string", "null"]
        },
        "access_status": {
          "type": ["string", "null"]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  }
}
