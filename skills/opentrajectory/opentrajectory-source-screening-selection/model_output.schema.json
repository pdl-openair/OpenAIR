{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenTrajectorySourceScreeningSelectionModelOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judgments"
  ],
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "decision",
          "reading_priority",
          "reason"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "priority",
              "supporting",
              "defer",
              "exclude"
            ]
          },
          "evidence_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "core",
                "mechanism",
                "method",
                "benchmark",
                "background"
              ]
            }
          },
          "relevant_target_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reading_priority": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  }
}
