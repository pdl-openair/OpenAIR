{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceAccessReadinessResolverInput",
  "type": "object",
  "required": ["task_id", "skill_id", "candidates"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string" },
    "skill_id": {
      "type": "string",
      "const": "source-access-readiness-resolver-skill"
    },
    "run_id": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DedupedCandidate" }
    },
    "resolver_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefer_structured_fulltext": { "type": "boolean", "default": true },
        "allow_network_probe": {
          "type": "boolean",
          "default": false,
          "description": "Initial contract is metadata-only. Network probing must be explicitly enabled by later implementation."
        },
        "allowed_access_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["html", "xml", "tei", "pdf", "landing_page", "metadata_only"]
          },
          "default": ["html", "xml", "tei", "pdf", "landing_page", "metadata_only"]
        }
      }
    }
  },
  "$defs": {
    "DedupedCandidate": {
      "type": "object",
      "required": ["candidate_id", "title", "provenance"],
      "additionalProperties": true,
      "properties": {
        "candidate_id": { "type": "string" },
        "canonical_source_id": { "type": "string" },
        "title": { "type": "string" },
        "normalized_title": { "type": "string" },
        "abstract": { "type": "string" },
        "doi": { "type": "string" },
        "publication_year": { "type": ["integer", "null"] },
        "source_name": { "type": "string" },
        "source_url": { "type": "string" },
        "landing_page_url": { "type": "string" },
        "pdf_url": { "type": "string" },
        "external_ids": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "doi": { "type": "string" },
            "arxiv_id": { "type": "string" },
            "pmid": { "type": "string" },
            "pmcid": { "type": "string" },
            "openalex_id": { "type": "string" },
            "semantic_scholar_id": { "type": "string" },
            "corpus_id": { "type": "string" }
          }
        },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProvenanceRecord" }
        }
      }
    },
    "ProvenanceRecord": {
      "type": "object",
      "required": ["stage", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "stage": { "type": "string" },
        "skill_id": { "type": "string" },
        "source_name": { "type": "string" },
        "matched_query": { "type": "string" },
        "query_index": { "type": ["integer", "null"] },
        "timestamp": { "type": "string" }
      }
    }
  }
}
