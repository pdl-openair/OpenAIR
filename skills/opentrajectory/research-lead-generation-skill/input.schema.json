{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "research-lead-generation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "research_context",
    "findings_packet"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Required invocation correlation identifier. It is copied into audit and included in input_fingerprint; it does not affect research_lead_id."
    },
    "research_context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "research_object"
      ],
      "properties": {
        "research_object": {
          "type": "string",
          "minLength": 1
        },
        "target_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_intent": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mechanism_packet": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mechanism_edges",
        "mechanism_chains"
      ],
      "properties": {
        "mechanism_edges": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "edge_id",
              "edge_status",
              "evidence_ids"
            ],
            "properties": {
              "edge_id": {
                "type": "string",
                "pattern": "^me:[0-9a-f]{20}$"
              },
              "edge_status": {
                "enum": [
                  "support",
                  "conflict",
                  "gap"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "mechanism_chains": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "chain_id",
              "edge_ids",
              "chain_summary"
            ],
            "properties": {
              "chain_id": {
                "type": "string",
                "pattern": "^mc:[0-9a-f]{20}$"
              },
              "edge_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^me:[0-9a-f]{20}$"
                }
              },
              "chain_summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "conflicts": {
          "type": "array"
        },
        "gaps": {
          "type": "array"
        },
        "summary": {
          "type": "object"
        },
        "audit": {
          "type": "object"
        },
        "synthesis_warnings": {
          "type": "array"
        }
      }
    },
    "findings_packet": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "findings"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "finding_id",
              "statement",
              "epistemic_status",
              "provenance_evidence_ids",
              "basis_mechanism_edge_ids"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^fd:[0-9a-f]{20}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "epistemic_status": {
                "enum": [
                  "supported",
                  "uncertain",
                  "conflicting",
                  "boundary_limited"
                ]
              },
              "provenance_evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis_mechanism_edge_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gap_mechanism_edge_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "generation_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_research_leads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Maximum number of unique validated research leads finalized. 0 disables lead finalization; if generation_config is omitted, the runtime default is 8."
        },
        "focus_questions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional research-context hints for the LLM. They do not relax provenance or claim-layer validation."
        }
      },
      "required": [
        "max_research_leads"
      ],
      "description": "Optional generation controls. If present, max_research_leads is required. If omitted, max_research_leads defaults to 8."
    }
  }
}
