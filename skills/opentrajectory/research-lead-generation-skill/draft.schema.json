{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "research-lead-generation LLM draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["research_leads", "generation_warnings"],
  "properties": {
    "research_leads": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lead_kind",
          "title",
          "research_question",
          "investigation_target",
          "rationale",
          "source_finding_ids",
          "mechanism_basis_edge_ids",
          "gap_edge_ids",
          "provenance_evidence_ids",
          "boundary_conditions",
          "scientific_significance",
          "uncertainties",
          "confidence",
          "semantic_boundary_judgment"
        ],
        "properties": {
          "lead_kind": {
            "enum": [
              "mechanism_gap",
              "unresolved_conflict",
              "boundary_extension",
              "underexplored_relationship",
              "measurement_gap",
              "transferability_question",
              "other"
            ]
          },
          "title": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "research_question": {"type": "string", "minLength": 2, "pattern": ".*\\?\\s*$"},
          "investigation_target": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "rationale": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "source_finding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^fd:[0-9a-f]{20}$"}
          },
          "mechanism_basis_edge_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^me:[0-9a-f]{20}$"}
          },
          "gap_edge_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^me:[0-9a-f]{20}$"}
          },
          "provenance_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          },
          "boundary_conditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          },
          "scientific_significance": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
          "uncertainties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "semantic_boundary_judgment": {
            "enum": [
              "within_research_lead_boundary",
              "hypothesis",
              "prediction",
              "expected_direction",
              "recommendation",
              "experiment_plan",
              "causal_conclusion"
            ],
            "description": "LLM semantic judgment of whether the proposed content remains a research lead or crosses into a downstream/forbidden claim type. The runtime validates this declared judgment and does not infer it from text."
          }
        }
      }
    },
    "generation_warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
    }
  }
}
